# ===========================================
# Jakselnews Environment Variables - PRODUCTION
# ===========================================
# Copy this file to .env.production and fill in the values

# ===========================================
# SERVER CONFIGURATION
# ===========================================
PORT=5000
NODE_ENV=production

# ===========================================
# SUPABASE CONFIGURATION
# Get from: https://supabase.com/project/_/settings/api
# ===========================================
SUPABASE_URL=https://eqoyvbeusopskzacoowz.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE
SUPABASE_SERVICE_KEY=YOUR_SERVICE_KEY_HERE

# ===========================================
# JWT CONFIGURATION - CRITICAL!
# Generate with: openssl rand -base64 64
# MUST be changed before production deployment!
# ===========================================
JWT_SECRET=YOUR_SUPER_SECRET_JWT_KEY_AT_LEAST_64_CHARS_LONG_HERE

JWT_EXPIRES_IN=7d

# ===========================================
# WORDPRESS CONFIGURATION
# ===========================================
WORDPRESS_URL=https://jakselnews.com
WORDPRESS_API_URL=https://jakselnews.com/wp-json/wp/v2

# ===========================================
# CORS CONFIGURATION - Comma separated domains
# ===========================================
CORS_ORIGIN=https://jakselnews.com,https://www.jakselnews.com,https://jakselnews.vercel.app

# ===========================================
# RATE LIMITING - Per route configuration
# ===========================================
# Public endpoints (articles, categories)
RATE_LIMIT_PUBLIC_WINDOW_MS=60000
RATE_LIMIT_PUBLIC_MAX=100

# Auth endpoints (login, register) - stricter
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=5

# Report creation
RATE_LIMIT_REPORTS_WINDOW_MS=60000
RATE_LIMIT_REPORTS_MAX=10

# ===========================================
# FILE UPLOAD (optional - using Supabase Storage)
# ===========================================
# MAX_FILE_SIZE_MB=5
# ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,video/mp4

# ===========================================
# EMAIL (optional - Resend API)
# Get from: https://resend.com/api-keys
# ===========================================
# RESEND_API_KEY=re_YOUR_API_KEY_HERE
# EMAIL_FROM=Jakselnews <noreply@jakselnews.com>

# ===========================================
# LOGGING
# ===========================================
LOG_LEVEL=info

# ===========================================
# VPS CONFIGURATION (for Nginx reverse proxy)
# ===========================================
DOMAIN=jakselnews.com
API_SUBDOMAIN=api.jakselnews.com
